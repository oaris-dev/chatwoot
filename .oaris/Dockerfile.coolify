# Coolify-specific Dockerfile that extends official Chatwoot image with custom branding
FROM chatwoot/chatwoot:latest

# Copy custom branding files
COPY config/installation_config.yml /app/config/installation_config.yml
COPY public/brand-assets/logo.svg /app/public/brand-assets/logo.svg
COPY public/brand-assets/logo_dark.svg /app/public/brand-assets/logo_dark.svg

# Copy updated Vue components with branding
COPY app/javascript/v3/views/auth/signup/Index.vue /app/app/javascript/v3/views/auth/signup/Index.vue
COPY app/javascript/v3/views/login/Index.vue /app/app/javascript/v3/views/login/Index.vue
COPY app/javascript/v3/views/login/Saml.vue /app/app/javascript/v3/views/login/Saml.vue
