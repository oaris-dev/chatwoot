# Chatwoot Oaris Edition - Environment Variables Example
# Copy this file to .env and fill in your own values
# NEVER commit .env to version control!

# === REQUIRED: Rails Secret ===
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=your_128_character_secret_key_here

# === Database Configuration ===
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# === Redis Configuration ===
REDIS_PASSWORD=your_secure_redis_password

# === Application Configuration ===
FRONTEND_URL=http://localhost:3000

# === Optional: SMTP Configuration (for emails) ===
# CHATWOOT_MAILER_SENDER_EMAIL=noreply@example.com
# CHATWOOT_SMTP_ADDRESS=smtp.example.com
# CHATWOOT_SMTP_PORT=587
# CHATWOOT_SMTP_USERNAME=your_smtp_username
# CHATWOOT_SMTP_PASSWORD=your_smtp_password
